@{
    ViewData["Title"] = "Register - WhatsApp Clone";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #00a884;
            --primary-glow: rgba(0, 168, 132, 0.4);
            --bg-dark: #0c141a;
            --card-bg: rgba(30, 42, 50, 0.6);
            --text-main: #e9edef;
            --text-dim: #8696a0;
            --glass-border: rgba(255, 255, 255, 0.08);
            --input-bg: rgba(255, 255, 255, 0.03);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
        }

        body {
            background: #080e12;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
            padding: 20px;
        }

        /* Abstract Background Elements */
        .bg-blob {
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
            border-radius: 50%;
            z-index: -1;
            filter: blur(80px);
            animation: blobMove 20s infinite alternate ease-in-out;
        }

        .blob-1 { top: -100px; left: -100px; }
        .blob-2 { bottom: -100px; right: -100px; background: radial-gradient(circle, rgba(54, 116, 255, 0.1) 0%, transparent 70%); }

        @@keyframes blobMove {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(100px, -50px) scale(1.1); }
        }

        .main-wrapper {
            display: flex;
            width: 90%;
            max-width: 1100px;
            min-height: 750px;
            background: var(--card-bg);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
            animation: wrapperEntrance 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes wrapperEntrance {
            from { opacity: 0; transform: translateY(50px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Info Section */
        .info-pane {
            flex: 1.2;
            background: linear-gradient(135deg, rgba(0, 168, 132, 0.1) 0%, rgba(0, 168, 132, 0.02) 100%);
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            border-right: 1px solid var(--glass-border);
        }

        .info-pane::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png');
            opacity: 0.03;
            pointer-events: none;
        }

        .brand-logo {
            font-size: 3.5rem;
            color: var(--primary);
            margin-bottom: 30px;
            filter: drop-shadow(0 0 15px var(--primary-glow));
        }

        .info-pane h1 {
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
            background: linear-gradient(to right, #fff, #8696a0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .info-pane p {
            color: var(--text-dim);
            font-size: 1.1rem;
            line-height: 1.6;
            max-width: 400px;
        }

        /* Form Section */
        .form-pane {
            flex: 1;
            padding: 40px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow-y: auto;
        }

        .form-pane h2 {
            font-size: 2rem;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-pane .subtitle {
            color: var(--text-dim);
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .profile-upload-container {
            text-align: center;
            margin-bottom: 30px;
            position: relative;
        }

        .profile-preview {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--input-bg);
            border: 2px dashed var(--glass-border);
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: var(--text-dim);
            cursor: pointer;
            transition: all 0.3s;
            overflow: hidden;
            background-size: cover;
            background-position: center;
        }

        .profile-preview:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: scale(1.05);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-dim);
            margin-bottom: 8px;
            font-weight: 500;
            padding-left: 4px;
        }

        .input-control {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 14px 18px;
            color: #fff;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            outline: none;
        }

        .input-control:focus {
            border-color: var(--primary);
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 25px rgba(0, 168, 132, 0.1);
        }

        .register-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary), #00c99d);
            border: none;
            border-radius: 14px;
            color: #fff;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-top: 10px;
            box-shadow: 0 10px 30px rgba(0, 168, 132, 0.3);
        }

        .register-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(0, 168, 132, 0.4);
        }

        .footer-links {
            margin-top: 25px;
            text-align: center;
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        .footer-links a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            margin-left: 5px;
        }

        #status-msg {
            margin-top: 15px;
            padding: 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            display: none;
            text-align: center;
        }

        /* Responsive Design */
        @@media (max-width: 900px) {
            .info-pane { display: none; }
            .main-wrapper { max-width: 500px; min-height: auto; }
            .form-pane { padding: 40px; }
        }

        @@media (max-width: 500px) {
            .main-wrapper { width: 100%; min-height: 100vh; border-radius: 0; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <div class="main-wrapper">
        <div class="info-pane">
            <div class="brand-logo">
                <i class="fa-brands fa-whatsapp"></i>
            </div>
            <h1>Join the revolution.</h1>
            <p>Create your account and start connecting with friends and family in a whole new way.</p>
            
            <div style="margin-top: auto; display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; align-items: center; gap: 12px; color: var(--text-dim);">
                    <i class="fa-solid fa-circle-check" style="color: var(--primary);"></i>
                    <span>End-to-end encrypted</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px; color: var(--text-dim);">
                    <i class="fa-solid fa-circle-check" style="color: var(--primary);"></i>
                    <span>Real-time notifications</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px; color: var(--text-dim);">
                    <i class="fa-solid fa-circle-check" style="color: var(--primary);"></i>
                    <span>Premium Glassmorphic UI</span>
                </div>
            </div>
        </div>

        <div class="form-pane">
            <div class="mobile-logo" style="display: none; font-size: 3rem; color: var(--primary); margin-bottom: 15px; text-align: center;">
                <i class="fa-brands fa-whatsapp"></i>
            </div>

            <h2>Create Account</h2>
            <p class="subtitle">Join thousands of users worldwide.</p>

            <div class="profile-upload-container">
                <div class="profile-preview" id="preview" onclick="document.getElementById('profilePic').click()">
                    <i class="fa-solid fa-camera"></i>
                </div>
                <input type="file" id="profilePic" accept="image/*" style="display: none;" onchange="previewImage(this)" />
                <p style="font-size: 0.8rem; color: var(--text-dim);">Tap to upload photo</p>
            </div>

            <div class="form-group">
                <label>Username</label>
                <input type="text" id="username" class="input-control" placeholder="Choose a unique name" />
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" id="email" class="input-control" placeholder="name@example.com" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" id="password" class="input-control" placeholder="Minimum 6 characters" />
            </div>

            <button class="register-btn" onclick="register()">
                Get Started <i class="fa-solid fa-rocket" style="margin-left: 8px; font-size: 0.9rem;"></i>
            </button>

            <div id="status-msg"></div>

            <div class="footer-links">
                Already member? <a href="/Auth/Login">Sign In here</a>
            </div>
        </div>
    </div>

    <style>
        @@media (max-width: 900px) {
            .mobile-logo { display: block !important; }
        }
    </style>

    <script>
        function previewImage(input) {
            const preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.style.backgroundImage = `url('${e.target.result}')`;
                    preview.innerHTML = '';
                    preview.style.borderStyle = 'solid';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function register() {
            const username = document.getElementById("username").value;
            const email = document.getElementById("email").value;
            const password = document.getElementById("password").value;
            const profilePic = document.getElementById("profilePic").files[0];
            const btn = document.querySelector(".register-btn");

            if (!username || !email || !password) {
                showStatus("Please fill in all required fields.", "#ff6b6b");
                return;
            }

            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Creating Account...';
            btn.disabled = true;

            const formData = new FormData();
            formData.append("Username", username);
            formData.append("Email", email);
            formData.append("Password", password);
            if (profilePic) {
                formData.append("ProfilePicture", profilePic);
            }

            try {
                const response = await fetch("/register", {
                    method: "POST",
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    showStatus(data.message + " Redirecting...", "#2ecc71");
                    setTimeout(() => {
                        window.location.href = "/Auth/Login";
                    }, 2000);
                } else {
                    showStatus(data.message, "#ff6b6b");
                }
            } catch (err) {
                showStatus("Something went wrong. Please try again.", "#ff6b6b");
            } finally {
                if (!btn.disabled === false) { // Only if not redirecting
                     btn.innerHTML = 'Get Started <i class="fa-solid fa-rocket" style="margin-left: 8px; font-size: 0.9rem;"></i>';
                     btn.disabled = false;
                }
            }
        }

        function showStatus(msg, color) {
            const statusMsg = document.getElementById("status-msg");
            statusMsg.innerText = msg;
            statusMsg.style.color = color;
            statusMsg.style.display = "block";
            statusMsg.style.background = color === "#2ecc71" ? "rgba(46, 204, 113, 0.1)" : "rgba(255, 107, 107, 0.1)";
            statusMsg.style.border = `1px solid ${color}33`;
        }
    </script>
</body>
</html>
